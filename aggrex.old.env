# Copy to /etc/aggrex/aggrex.env on the VPS and restrict access to root.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_URL=https://aggrex.howeyhost.com
DATABASE_PATH=/var/lib/aggrex/app.db

# Generate separate random values on the VPS; both are required in production.
JWT_SECRET=728c97e2e844f70e2831ea1d7004d8bda97b2815e13bd0462ce63c6094426d9c
COOKIE_SECRET=1ab1beb8b82bf1e1a006098980328a935c0add2a77a93103a07f074993291b48
SESSION_TTL_DAYS=7

# Set this before opening sign-in to the public.
ADMIN_EMAILS=howey.matt@gmail.com
ENABLE_DEV_LOGIN=false

# Configure at least one provider to enable production sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=