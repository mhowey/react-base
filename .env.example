# ── Core ─────────────────────────────────────────────
PORT=3000
# Public origin. Used for OAuth callbacks, canonical URLs, sitemap, llms.txt.
APP_URL=http://localhost:3000
DATABASE_PATH=data/app.db
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=
SESSION_TTL_DAYS=7

# Comma separated list of emails that are always admins.
# If empty, the first user to sign in becomes admin.
ADMIN_EMAILS=

# Passwordless dev login (defaults to on outside production). Never enable in production.
# ENABLE_DEV_LOGIN=true

# ── OAuth providers (a provider is enabled when both values are set) ──
# Callback URL to register with each provider: ${APP_URL}/api/auth/<provider>/callback

# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Client-side public site URL (optional; defaults to window.location.origin)
# VITE_SITE_URL=https://example.com
